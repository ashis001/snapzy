<?xml version="1.0" encoding="utf-8"?>
<!--
    The Movexa launcher icon.

    A calm aqua-to-indigo gradient — the same two brand colours the app uses —
    with a white play mark in the safe zone of the adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="0"
                android:endX="100"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF3DDCC0" />
                <item android:offset="0.55" android:color="#FF4FC8CE" />
                <item android:offset="1" android:color="#FF6E6AF0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
