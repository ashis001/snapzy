<?xml version="1.0" encoding="utf-8"?>
<!--
    The Movexa launch mark: a play triangle inside a rounded frame.

    Drawn on the 108x108 adaptive-icon grid, inside the 66x66 safe zone so no
    launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The frame: a rounded rectangle, drawn as a stroke. -->
    <path
        android:pathData="M30,30 L78,30 A6,6 0 0 1 84,36 L84,72 A6,6 0 0 1 78,78 L30,78 A6,6 0 0 1 24,72 L24,36 A6,6 0 0 1 30,30 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeAlpha="0.92"
        android:fillColor="#00000000" />

    <!-- The play mark. -->
    <path
        android:pathData="M45,40 L45,68 L69,54 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
