<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Device gallery browsing. API 33+ uses the granular READ_MEDIA_* permissions;
         API 32 and below fall back to READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Voice-over recording in the video editor. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Network access for the server-backed (Coming Soon) AI features. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Snapzy"
        android:theme="@style/Theme.Snapzy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Snapzy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.snapzy.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
